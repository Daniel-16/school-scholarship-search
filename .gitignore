# Dependencies
node_modules
bun.lock

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Compiled documents
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
build/

# ---------------------------------------------------------------------------
# Personal data. Nothing below this line is ever committed.
# ---------------------------------------------------------------------------

# Discovery state. Depth-independent: the program-scout skill resolves
# `program_search/` relative to its own directory, so these can land at
# .claude/skills/program-scout/program_search/* where a rooted pattern would
# silently fail to match them.
**/program_search/seen_programs.json
**/program_search/notion_sync.json
**/program_search/*.md

# Generated application documents (written by /apply - do not share).
# Extension-agnostic on the ignore side: a custom template registered via
# /add-template may write main_<key>.typ rather than .tex, and it must be
# ignored just as reliably. The negations stay .tex-only, because a wildcard
# negation would also re-include build artifacts like main_example.pdf.
cv/main_*.*
!cv/main_example.tex
cv/*.txt
statements/sop_*.*
statements/essay_*.*
statements/proposal_*.*
statements/motivation_*.*
statements/*_[0-9]*.*
!statements/sop_example.tex
statements/*.txt

# Everything you supply: transcripts, degree certificates, test reports,
# passport scans, referee details, bank statements. Only the folder structure
# and the READMEs are tracked.
documents/transcripts/**
documents/degrees/**
documents/test_scores/**
documents/identity/**
documents/cv/**
documents/references/**
documents/research/**
documents/portfolio/**
documents/financial/**
# Per-application archives: the listing, form answers, uploads, and the
# interview prep packs, which quote what was submitted and set out your
# weak points.
documents/applications/**
!documents/**/.gitkeep

# Application tracking
application_tracker.csv

# Funding plans carry income, savings and sponsor details. The exchange-rate
# file is shared configuration, not personal, so it stays tracked.
funding/*.json
!funding/rates.json

# Gmail sync state (message IDs, subjects - personal data)
gmail_sync/

# Generated reports (/html-report) and exported calendars (/deadlines --ics)
reports/
deadlines/

# Profile-gap reports (personal output). Depth-independent like the
# program_search rules above. A bare `**/profile_gap/*.md` is not usable -
# the skill directory shares the name and it would ignore the skill's own
# files - so the report-file prefix is pinned instead.
profile_gap/*.md
**/profile_gap/report-*.md

# Secrets. A portal skill generated by /add-portal may need an API token for
# a fetching service; the .env holding it must never be committed.
.env
.env.*

# Personal photos and signatures
*.jpg
*.jpeg
*.png

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/
.claude/settings.local.json

# Skills lock (auto-generated)
skills-lock.json

# Agent skills: track the source, ignore only deps and logs.
# (A blanket `.agents/` ignore silently drops the portal CLIs from the repo.)
.agents/**/node_modules
.agents/**/*.log
.agents/usage/
